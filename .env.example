# ============================================# Database Configuration

# CUMPAIR - ENVIRONMENT CONFIGURATION TEMPLATEDATABASE_URL=postgresql://compair:compair123@localhost:5432/compair

# ============================================POSTGRES_DB=compair

# Copy this file to .env and fill in your valuesPOSTGRES_USER=compair

# Never commit .env to version controlPOSTGRES_PASSWORD=compair123



# ============================================# Redis Configuration

# ENVIRONMENT & DEBUGREDIS_URL=redis://localhost:6379

# ============================================

ENVIRONMENT=development  # development, staging, production# Application Configuration

DEBUG=trueDEBUG=False

LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERRORSECRET_KEY=your-secret-key-here

ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================

# DATABASE CONFIGURATION# AI Models Configuration

# ============================================CLIP_MODEL_NAME=ViT-B/32

# PostgreSQL connection (use managed service like Neon in production)YOLO_MODEL_PATH=yolov8n.pt

DATABASE_URL=postgresql://compair:compair123@postgres:5432/compair

POSTGRES_DB=compair# Scraping Configuration

POSTGRES_USER=compairSCRAPER_TIMEOUT=30

POSTGRES_PASSWORD=compair123MAX_CONCURRENT_REQUESTS=5

POSTGRES_HOST=postgres

POSTGRES_PORT=5432# Monitoring

PROMETHEUS_ENABLED=True

# ============================================GRAFANA_ADMIN_PASSWORD=admin

# REDIS CONFIGURATION

# ============================================# Frontend Configuration

# Redis for caching and task queue (use Upstash in production)VITE_API_URL=http://localhost:8000
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# CELERY CONFIGURATION
# ============================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=2

# ============================================
# SECURITY
# ============================================
# IMPORTANT: Change this in production! Minimum 32 characters
SECRET_KEY=change-this-to-a-secure-random-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# API CONFIGURATION
# ============================================
APP_NAME=Cumpair
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ============================================
# FILE UPLOADS
# ============================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.bmp

# ============================================
# AI/ML CONFIGURATION
# ============================================
MODELS_DIR=models
YOLO_MODEL_PATH=models/yolov8n.pt
EFFICIENTNET_MODEL_PATH=models/spec_extractor.h5
CLIP_MODEL_NAME=ViT-B/32
CLIP_CACHE_DIR=models/clip_cache

# External AI services (optional)
GROQ_API_KEY=
OPENAI_API_KEY=

# ============================================
# SCRAPER SERVICE CONFIGURATION
# ============================================
SCRAPER_SERVICE_URL=http://scraper:3001
MAX_CONCURRENT_REQUESTS=5
DOWNLOAD_DELAY=0.5
SCRAPING_TIMEOUT=30

# User agent rotation
USER_AGENTS_FILE=config/user_agents.txt

# ============================================
# PROXY CONFIGURATION
# ============================================
PROXY_SERVICE_URL=http://proxy:8001
PROXY_HEALTH_CHECK_INTERVAL=60
PROXY_MAX_FAILURES=3
PROXY_ROTATION_STRATEGY=health_based  # health_based, round_robin, random

# ============================================
# CAPTCHA SERVICE
# ============================================
CAPTCHA_SERVICE_URL=http://captcha:9001
CAPTCHA_API_KEY=
CAPTCHA_TIMEOUT=120
CAPTCHA_RETRY_ATTEMPTS=3

# ============================================
# BROWSER CONFIGURATION (for scraping)
# ============================================
BROWSER_HEADLESS=true
BROWSER_MAX_PAGES=10
BROWSER_TIMEOUT=30
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080

# ============================================
# ANTI-DETECTION SETTINGS
# ============================================
ENABLE_REQUEST_DELAYS=true
MIN_REQUEST_DELAY=0.5
MAX_REQUEST_DELAY=3.0
ENABLE_MOUSE_SIMULATION=true
ENABLE_SCROLL_SIMULATION=true

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# Grafana (if self-hosted)
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ============================================
# DOCKER SETTINGS
# ============================================
COMPOSE_HTTP_TIMEOUT=1800
DOCKER_CLIENT_TIMEOUT=1800
BUILDKIT_INLINE_CACHE=1

# ============================================
# NODE.JS SETTINGS (for scraper service)
# ============================================
NODE_ENV=development  # development, production
NODE_OPTIONS=--max_old_space_size=2048
PORT=3001

# ============================================
# MONETIZATION (for production)
# ============================================
# CrytoLens API key for license management
CRYPTOLENS_API_KEY=
CRYPTOLENS_PRODUCT_ID=

# Stripe for payments (when implementing subscriptions)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Affiliate tracking
AFFILIATE_TRACKING_ENABLED=true
CLICK_TRACKING_ENABLED=true

# ============================================
# DEPLOYMENT (production only)
# ============================================
# Cloud provider settings
DEPLOY_TARGET=digitalocean  # digitalocean, aws, gcp, azure
DO_TOKEN=
DO_DROPLET_ID=

# Domain & SSL
DOMAIN=api.cumpair.tech
ENABLE_TLS=true
LETSENCRYPT_EMAIL=

# HAProxy configuration
HAPROXY_ADMIN_USER=admin
HAPROXY_ADMIN_PASSWORD=
HAPROXY_STATS_PORT=8404

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_ANALYSIS=true
FEATURE_CLIP_SEARCH=true
FEATURE_GPU_MONITORING=true
FEATURE_DATABASE=true
FEATURE_PRICE_COMPARISON=true
FEATURE_SCRAPING=true
FEATURE_CACHING=true
