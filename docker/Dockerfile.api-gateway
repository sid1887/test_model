# API Gateway Service - Orchestrates all microservices
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel

# Core dependencies from requirements.txt
# Web Framework
RUN pip install \
    fastapi==0.115.2 \
    uvicorn==0.24.0.post1 \
    pydantic==2.12.3 \
    python-multipart==0.0.6 \
    python-dotenv==1.0.1

# HTTP Clients & Async
RUN pip install \
    httpx==0.25.0 \
    aiohttp==3.9.0 \
    aiofiles==24.1.0 \
    requests==2.31.0

# Caching & Task Queue
RUN pip install \
    redis==5.3.1 \
    hiredis==2.0.0 \
    celery==5.5.3

# Database (needed for potential queries to other services)
RUN pip install \
    sqlalchemy==2.0.44 \
    psycopg2-binary==2.9.9 \
    asyncpg==0.29.0

WORKDIR /app

# Copy API Gateway and any shared modules it needs
COPY api_gateway.py /app/
COPY requirements.txt /app/

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run service
CMD ["uvicorn", "api_gateway:app", "--host", "0.0.0.0", "--port", "8000"]
