# Speech & Image Processing Service - Voice STT, OCR, Image preprocessing
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    CUDA=false

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    pkg-config \
    libsm6 \
    libxext6 \
    libxrender-dev \
    ffmpeg \
    libavformat-dev \
    libavdevice-dev \
    libavfilter-dev \
    libswscale-dev \
    libswresample-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel

# Core dependencies
RUN pip install \
    fastapi==0.115.2 \
    uvicorn==0.24.0.post1 \
    pydantic==2.12.3 \
    httpx==0.25.0 \
    python-multipart==0.0.6

# Speech & Image dependencies
RUN pip install \
    easyocr==1.7.0 \
    opencv-python==4.8.1.78 \
    pillow==10.1.0 \
    numpy==1.24.3 \
    scipy==1.13.0 \
    librosa==0.10.0 \
    transformers==4.38.0 \
    openai-whisper==20231106 \
    pydub==0.25.1

# PyTorch (CPU-only)
RUN pip install torch==2.1.0 torchvision==0.16.0 --index-url https://download.pytorch.org/whl/cpu

WORKDIR /app

# Copy service code
COPY services/speech-image/ /app/

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8003/api/media/health || exit 1

# Run service
CMD ["python", "main.py"]
