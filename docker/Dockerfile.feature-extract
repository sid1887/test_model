# Feature Extraction Service - Embeddings & FAISS vector indexing
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel

# Core dependencies
RUN pip install \
    fastapi==0.115.2 \
    uvicorn==0.24.0.post1 \
    pydantic==2.12.3 \
    httpx==0.25.0 \
    python-multipart==0.0.6

# Feature extraction & vector search
RUN pip install --no-cache-dir \
    sentence-transformers==2.2.2 \
    numpy==1.24.3 \
    scikit-learn==1.4.0

WORKDIR /app

# Copy service code
COPY services/feature-extract/ /app/

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8004/api/features/health || exit 1

# Run service
CMD ["python", "main.py"]
