# HuggingFace Connector Service - Text generation, sentiment, NER, captioning
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    CUDA=false

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel

# Core dependencies
RUN pip install \
    fastapi==0.115.2 \
    uvicorn==0.24.0.post1 \
    pydantic==2.12.3 \
    httpx==0.25.0

# HuggingFace & ML dependencies
RUN pip install \
    transformers==4.38.0 \
    torch==2.1.0 --index-url https://download.pytorch.org/whl/cpu \
    torchvision==0.16.0 --index-url https://download.pytorch.org/whl/cpu \
    accelerate==0.27.0 \
    datasets==2.16.0 \
    pillow==10.1.0 \
    numpy==1.24.3

WORKDIR /app

# Copy service code
COPY services/hf-connector/ /app/

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8002/api/hf/health || exit 1

# Run service
CMD ["python", "main.py"]
