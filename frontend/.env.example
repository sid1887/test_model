# Frontend Environment Configuration for Cumpair Backend Integration
# NOTE: Vite uses VITE_ prefix, not NEXT_PUBLIC_

# API Configuration
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Image Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Feature Flags
VITE_ENABLE_REAL_TIME_SEARCH=true
VITE_ENABLE_PRICE_ALERTS=true
VITE_ENABLE_ANALYTICS=true

# Search Configuration
VITE_DEFAULT_SEARCH_SITES=amazon,walmart,ebay
VITE_MIN_SIMILARITY_SCORE=0.7
VITE_MAX_SEARCH_RESULTS=20

# Development Settings
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=info

# Production Settings (comment out for development)
# VITE_API_URL=https://your-production-api.com
# VITE_DEBUG_MODE=false
# VITE_LOG_LEVEL=error
