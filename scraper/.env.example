# Scraper Service Configuration

# Server
PORT=3001
NODE_ENV=production

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Scraping Configuration
MAX_CONCURRENT_SCRAPERS=5
DEFAULT_TIMEOUT=30000
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
HEADLESS=true

# User Agent
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Proxy and Captcha Services (Integration)
USE_PROXY_ROTATION=true
PROXY_SERVICE_URL=http://cumpair-proxy-api:8001
HAPROXY_URL=http://cumpair-proxy-manager:8080
CAPTCHA_SERVICE_URL=http://captcha:9001

# Rate Limiting
RATE_LIMIT_POINTS=5
RATE_LIMIT_DURATION=1000

# Proxy Rotation
PROXY_ROTATION_INTERVAL=5
